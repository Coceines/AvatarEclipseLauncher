ItemBox < Panel
  size: 34 34
  background-color: #1a1d24
  border-width: 1
  border-color: #2c3240

  $hover:
    border-color: #4a90e2

PlusButton < UIButton
  size: 34 34
  image-source: /images/game/helperimg/plus
  image-border: 0
  padding: 0
  border-width: 0

  $hover:
    opacity: 0.85

  $pressed:
    opacity: 0.7

PowerButton < UIButton
  size: 34 34
  image-source: /images/game/helperimg/OFF
  image-border: 0
  padding: 0
  border-width: 0

  $hover:
    opacity: 0.85

  $pressed:
    opacity: 0.7
