// Botao lateral esquerdo: abre/fecha o mapa grande (game_map_overlay).
// A arte fica em modules/client_options/settings/minimap_button.png
// As ancoras sao definidas no map_overlay.lua (empilha acima do botao da mochila).
MapSideButton < UIWidget
  id: mapSideButton
  size: 52 76
  image-source: /modules/client_options/settings/minimap_button
  focusable: false
  phantom: true

  UIButton
    id: mapSideHit
    anchors.fill: parent
    image-source:
    background-color: #00000000
    focusable: false
    change-cursor-image: true
    cursor: pointer
    !tooltip: tr('Map')
    @onClick: modules.game_map_overlay.toggle()
