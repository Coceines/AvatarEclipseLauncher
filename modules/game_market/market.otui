MarketRow < Panel
  height: 56
  margin: 0 6 0 6
  background-color: alpha

  Item
    id: uiItem
    size: 36 36
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin: 10 0 0 10
    virtual: true

  Label
    id: lblItem
    anchors.left: uiItem.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 14
    font: verdana-11px-monochrome
    color: #d8d8d8
    text-auto-resize: true

  // TIER do item, logo depois do nome (o texto vem do servidor: market_lib.lua)
  Label
    id: lblTier
    anchors.left: lblItem.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    font: verdana-11px-monochrome
    color: #ffd700
    text-auto-resize: true

  Label
    id: lblPlayer
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 300
    font: verdana-11px-monochrome
    color: #a0a0a0
    text-auto-resize: true

  Label
    id: lblQtd
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 470
    font: verdana-11px-monochrome
    color: #c8c8c8
    text-auto-resize: true

  Label
    id: lblPrice
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 525
    font: verdana-11px-monochrome
    color: #ffd700
    text-auto-resize: true

  Button
    id: btnAction
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 10
    !text: tr('Comprar')
    text-auto-resize: true
    font: verdana-11px-monochrome

  $!alternate:
    background-color: #ffffff08

  $hover:
    background-color: #ffffff16


MainWindow
  size: 760 560
  padding-top: 20
  !text: tr('Market')
  visible: false

  UIButton
    id: btnClose
    size: 14 14
    anchors.top: parent.top
    anchors.right: parent.right
    image-source: /images/ui/miniwindow_buttons
    image-clip: 28 0 14 14
    margin-right: -3
    @onClick: self:getParent():hide()

    $hover:
      image-clip: 28 14 14 14

    $pressed:
      image-clip: 28 28 14 14

  Panel
    id: searchPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 34
    margin: 28 14 0 14
    background-color: #00000055

    Label
      id: lblSearch
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      margin-left: 8
      font: verdana-11px-monochrome
      color: #9a9a9a
      !text: tr('Buscar:')

    TextEdit
      id: edtSearch
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: lblSearch.right
      anchors.right: btnRefresh.left
      margin: 0 10 0 10
      height: 24
      @onTextChange: Market.onSearchTextChange(self:getText())

    Button
      id: btnClearSearch
      size: 24 24
      anchors.verticalCenter: parent.verticalCenter
      anchors.right: btnRefresh.left
      margin-right: 6
      text: X
      !tooltip: tr('Limpar busca')
      @onClick: Market.clearSearch()

    Button
      id: btnRefresh
      size: 26 26
      anchors.verticalCenter: parent.verticalCenter
      anchors.right: parent.right
      margin-right: 8
      icon: ui/refresh
      !tooltip: tr('Atualizar Ofertas')
      @onClick: Market.refresh()

  Panel
    id: filterPanel
    anchors.top: searchPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 30
    margin: 6 14 0 14
    background-color: #00000044

    Label
      id: lblFilter
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      margin-left: 8
      font: verdana-11px-monochrome
      color: #9a9a9a
      !text: tr('Filtrar:')

    ComboBox
      id: cmbFilter
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: lblFilter.right
      anchors.right: parent.right
      margin: 0 8 0 8
      height: 20

  // Filtro de TIER, logo abaixo do "Filtrar" (categoria)
  Panel
    id: tierPanel
    anchors.top: filterPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 30
    margin: 6 14 0 14
    background-color: #00000044

    Label
      id: lblTierFilter
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      margin-left: 8
      font: verdana-11px-monochrome
      color: #9a9a9a
      !text: tr('Tier:')

    ComboBox
      id: cmbTier
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: lblTierFilter.right
      anchors.right: parent.right
      margin: 0 8 0 8
      height: 20

  Panel
    id: headerPanel
    anchors.top: tierPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 24
    margin: 8 14 0 14
    background-color: #00000044

    Label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 58
      font: verdana-11px-monochrome
      color: #7a7a7a
      !text: tr('Item')

    Label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 300
      font: verdana-11px-monochrome
      color: #7a7a7a
      !text: tr('Jogador')

    Label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 470
      font: verdana-11px-monochrome
      color: #7a7a7a
      !text: tr('Qtd')

    Label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 525
      font: verdana-11px-monochrome
      color: #7a7a7a
      !text: tr('Pre�o')

  TextList
    id: marketList
    anchors.top: headerPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: pagination.top
    margin: 4 14 0 14
    vertical-scrollbar: scrollItems
    background-color: #00000022
    border-width: 1
    border-color: #2a2a2a

  VerticalScrollBar
    id: scrollItems
    anchors.top: marketList.top
    anchors.bottom: marketList.bottom
    anchors.left: marketList.right
    margin-left: 2
    step: 56
    pixels-scroll: true

  Panel
    id: pagination
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: btnAddOffer.top
    height: 30
    margin: 6 14 0 14

    Button
      id: btnPrev
      size: 26 26
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      !tooltip: tr('P�gina Anterior')
      text: <
      @onClick: Market.nextAndPrev(0)

    Label
      id: lblIndex
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: btnPrev.right
      margin-left: 10
      font: verdana-11px-monochrome
      color: #c8c8c8
      text: P�gina: 1/1

    Button
      id: btnNext
      size: 26 26
      anchors.verticalCenter: parent.verticalCenter
      anchors.right: parent.right
      !tooltip: tr('Pr�xima P�gina')
      text: >
      @onClick: Market.nextAndPrev(1)

  Button
    id: btnAddOffer
    size: 190 30
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 8
    !text: tr('Adicionar Oferta')
    font: verdana-11px-monochrome
    !tooltip: tr('Abre a mira (crosshair): clique no item que voce quer vender - da mochila ou do deposito. Botao direito cancela.')
    @onClick: Market.showAddOffer()

  Button
    id: btnMarketHelp
    size: 26 26
    anchors.left: btnAddOffer.right
    anchors.verticalCenter: btnAddOffer.verticalCenter
    margin-left: 10
    icon: /images/topbuttons/marketinterrog
    !tooltip: tr('Como funciona o Market:\nVoc� compra e vende itens com outros jogadores.\nPre�o m�nimo por oferta: 1.000 gold (sem teto pr�tico de pre�o).\n\nComo vender:\n1. Clique em "Adicionar Oferta".\n2. Com a mira, clique no item (da mochila ou do dep�sito).\n3. Confira o item na janela, escolha o pre�o e a quantidade.\n4. Clique em "Adicionar".\n\nLimites por personagem:\n- M�ximo de 5 ofertas ativas.\n- M�ximo de 100 itens por oferta.\n- Itens �nicos (n�o-stack�veis): apenas 1 unidade.\n\nRegras:\n- Apenas equipamentos, armas e itens especiais podem ser vendidos.\n- S� � poss�vel usar dentro de �rea PZ.\n- O lucro das vendas fica no seu saldo do market.')

    $hover:
      background-color: #ffffff22
