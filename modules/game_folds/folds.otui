SpellProgress < UIProgressRect
  background: #585858AA
  percent: 0
  ring: true
  ring-thickness: 3
  focusable: false
  font: verdana-11px-rounded
  image-source: /images/folds/moldura
  anchors.left: parent.left
  anchors.top: parent.top
  size: 32 32
  text-align: center

Folds < UIButton
  size: 32 32
  anchors.top: parent.top
  anchors.left: parent.left
  focusable: false

CooldownFlash < UIWidget
  background-color: #ffffff
  phantom: true
  focusable: false

folds
  id: foldWindow
  width: 515
  height: 90
  anchors.bottom: gameBottomPanel.top
  anchors.horizontalCenter: parent.horizontalCenter
  focusable: false
  &save: true
  phantom: true
  dragable: true
  image-source: bg
  image-auto-resize: true
  image-shader: spellbar_bg

