Module
  name: game_interface
  description: Create the game interface, where the ingame stuff starts
  author: OTClient team
  website: www.otclient.info
  sandboxed: true
  scripts: [ widgets/uigamemap, widgets/uiitem, gameinterface ]
  load-later:
    - game_textmessage
    - game_hotkeys
    - game_console
    - game_outfit
    - game_pet
    - game_healthinfo
    - game_skills
    - game_inventory
    - game_containers
    - game_cast
    - game_iguild
    - game_viplist
    - game_battle
    - game_minimap
    - game_npctrade
    - game_textwindow
    - game_playertrade
    - game_playerdeath
    - game_ruleviolation
    - game_modaldialog
    - game_npctrade
    - game_folds
    - game_firstlogin
    // montaria desativada (o servidor recusa montar: creaturescripts/scripts/onMount.lua)
    // - game_playermount
    - game_shaders
    - game_skyclouds
    - game_itemfly
    - game_controller
    - game_notification
    - game_outfit_scales
    - game_offset

  @onLoad: init()
  @onUnload: terminate()
