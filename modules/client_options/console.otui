OptionPanel
  OptionCheckBox
    id: showInfoMessagesInConsole
    margin: 0 0 0 8

    UILabel
      id: label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 275 30
      !text: tr('Show info messages in console')
      text-offset: 0 5
      font: verdana-11px-antialised

  OptionCheckBox
    id: showEventMessagesInConsole
