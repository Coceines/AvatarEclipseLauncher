// Botao lateral esquerdo: abre a janela da task diaria (game_dailyhunt).
// A arte fica em modules/client_options/settings/daily_task_button.png
// As ancoras sao definidas no dailyhunt.lua (empilha acima do botao do helper).
DailyHuntSideButton < UIWidget
  id: dailyHuntSideButton
  size: 52 76
  image-source: /modules/client_options/settings/daily_task_button
  focusable: false
  phantom: true

  UIButton
    id: dailyHuntSideHit
    anchors.fill: parent
    image-source:
    background-color: #00000000
    focusable: false
    change-cursor-image: true
    cursor: pointer
    !tooltip: tr('Daily Task')
    @onClick: modules.game_dailyhunt.toggle()
