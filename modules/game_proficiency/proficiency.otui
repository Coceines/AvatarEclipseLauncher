MiniStar < UIWidget
  id: miniStar
  size: 5 5
  image-source: /modules/game_proficiency/images/icon-star-tiny-silver
  image-clip: 0 0 5 5

ItemBox < UIButton
  size: 34 34
  image-source: /images/ui/item
  change-cursor-image: true
  cursor: pointer
  border-width: 0
  tooltip-delayed: true
  focusable: true

  $focus:
    border-width: 1
    border-color: #ffffff

  UIItem
    id: item
    size: 32 32
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 1
    virtual: true
    show-count: false
    draggable: false
    phantom: true

  UIWidget
    id: starsBackground
    height: 6
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 1
    margin-right: 1
    margin-bottom: 1
    phantom: true
    layout:
      type: horizontalBox
      spacing: 0

StarWidget < UIWidget
  id: starWidget
  size: 76 18
  background-color: #1a1a1a
  border-width: 1
  border-color: #333333
  tooltip-delayed: true

  ProgressBar
    id: starProgress
    anchors.fill: parent
    background-color: #d4af37
    margin: 1 1 1 1
    percent: 0

  UIWidget
    id: star
    size: 9 10
    phantom: true
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    image-source: /modules/game_proficiency/images/icon-star-dark

BonusIcon < UIWidget
  id: bonusIcon
  size: 56 56

  UIWidget
    size: 56 56
    id: highlight
    visible: false
    phantom: true
    image-source: /modules/game_proficiency/images/backdrop_weaponmastery_highlight
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter

  UIWidget
    id: border
    size: 54 54
    phantom: true
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    image-source: /modules/game_proficiency/images/border-weaponmasterytreeicons-inactive

  UIWidget
    id: icon
    size: 44 44
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    image-source: /modules/game_proficiency/images/icons-0
    image-clip: 0 0 64 64
    phantom: true

  UIWidget
    id: icon-grey
    size: 44 44
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    image-source: /modules/game_proficiency/images/icons-0
    image-clip: 0 64 64 64
    phantom: true

  UIWidget
    id: iconPerks
    size: 22 22
    anchors.top: icon.top
    anchors.right: icon.right
    margin-top: -6
    margin-right: -6
    visible: false
    phantom: true
    image-source: /modules/game_proficiency/images/augment-icons
    image-clip: 0 0 32 32

  UIWidget
    id: iconPerks-grey
    size: 22 22
    anchors.top: icon.top
    anchors.right: icon.right
    margin-top: -6
    margin-right: -6
    visible: false
    phantom: true
    image-source: /modules/game_proficiency/images/augment-icons
    image-clip: 0 32 32 32

  UIWidget
    id: locked-perk
    size: 14 20
    anchors.bottom: border.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: -4
    visible: false
    image-source: /modules/game_proficiency/images/big-icon-lock-grey

BonusSelectPanel < UIWidget
  id: bonusSelectPanel
  size: 76 240
  background-color: alpha

  ProgressBar
    id: bonusSelectProgress
    anchors.fill: parent
    background-color: alpha
    margin: 1 1 1 1
    percent: 0
    visible: false

  Panel
    id: oneBonusIconPanel
    anchors.fill: parent
    visible: false

    BonusIcon
      id: bonusIcon0
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter

  Panel
    id: twoBonusIconPanel
    anchors.fill: parent
    visible: false

    BonusIcon
      id: bonusIcon0
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 26

    BonusIcon
      id: bonusIcon1
      anchors.bottom: parent.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-bottom: 26

  Panel
    id: threeBonusIconPanel
    anchors.fill: parent
    visible: false

    BonusIcon
      id: bonusIcon0
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 6

    BonusIcon
      id: bonusIcon1
      anchors.top: bonusIcon0.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 16

    BonusIcon
      id: bonusIcon2
      anchors.top: bonusIcon1.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 16

BonusDetailPanel < UIWidget
  id: bonusDetailPanel
  size: 76 58
  background-color: #1a1a1a
  border-width: 1
  border-color: #2a2a2a

  UIWidget
    id: bonusName
    anchors.fill: parent
    margin: 2 2 2 2
    color: #c0c0c0
    text-align: center
    text-wrap: true
    tooltip-delayed: true

MainWindow
  id: weaponProficiencyWindow
  !text: tr('Weapon Proficiency')
  size: 745 435
  padding-top: 36
  padding-left: 16
  padding-right: 16
  padding-bottom: 14
  @onEscape: modules.game_proficiency.WeaponProficiency:onCloseWindow()

  Panel
    id: contentPanel
    anchors.fill: parent

    Panel
      id: itemPanel
      size: 160 132
      anchors.left: parent.left
      anchors.top: parent.top
      image-source: /images/ui/window
      image-border: 4

      Label
        id: itemNameTitle
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 5
        margin-left: 4
        margin-right: 4
        height: 16
        !text: tr('Unknown Item')
        color: #ffffff
        text-align: center

      UIWidget
        id: iconMasteryLevel
        size: 130 46
        anchors.top: itemNameTitle.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 3
        image-source: /modules/game_proficiency/images/icon-masterylevel-0

      UIWidget
        id: itemMasteryLevel
        size: 130 46
        anchors.top: itemNameTitle.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 3
        image-source: /modules/game_proficiency/images/icon-masterylevel-1-silver
        phantom: true
        visible: false

      Item
        id: item
        anchors.centerIn: iconMasteryLevel
        virtual: true
        priceable: false
        show-count: false

      Label
        id: progressDescription
        anchors.top: iconMasteryLevel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 3
        height: 14
        !text: tr('0 / 0')
        color: #e0e0e0
        text-align: center

      Label
        id: nextLevelDescription
        anchors.top: progressDescription.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 2
        height: 14
        !text: tr('0 EXP for next Lv.')
        color: #a0a0a0
        text-align: center

    TextEdit
      id: searchText
      size: 160 20
      focusable: true
      anchors.top: itemPanel.bottom
      anchors.left: parent.left
      margin-top: 6
      padding-top: 2
      padding-left: 4
      padding-right: 20
      !placeholder: tr('Type to search')

    Button
      id: clearSearchButton
      anchors.top: prev.top
      anchors.right: prev.right
      margin-top: 2
      margin-right: 2
      size: 16 16
      !text: tr('X')
      tooltip-delayed: true
      tooltip: Clear all text from the search field.
      @onClick: modules.game_proficiency.WeaponProficiency:clearSearch()

    TextList
      id: itemList
      size: 160 178
      anchors.top: searchText.bottom
      anchors.left: parent.left
      vertical-scrollbar: itemListScroll
      margin-top: 5
      color: #c0c0c0
      background-color: #141414
      border-width: 1
      border-color: #2a2a2a
      keep-scroll-range: true
      padding-top: 4
      padding-left: 4
      layout:
        type: grid
        cell-size: 34 34
        cell-spacing: 2
        num-columns: 4

    VerticalScrollBar
      id: itemListScroll
      anchors.top: prev.top
      anchors.bottom: prev.bottom
      anchors.right: prev.right
      margin-right: 1
      margin-top: 1
      margin-bottom: 1
      step: 36
      pixels-scroll: true

    Panel
      id: starsPanelBackground
      size: 532 18
      anchors.top: parent.top
      anchors.left: itemPanel.right
      margin-left: 10
      background-color: #1a1a1a
      border-width: 1
      border-color: #333333
      layout:
        type: grid
        cell-size: 76 18
        num-columns: 7

    Panel
      id: progressBackground
      size: 532 10
      anchors.top: prev.bottom
      anchors.left: prev.left
      margin-top: 2
      background-color: #151515
      border-width: 1
      border-color: #2a2a2a

      ProgressBar
        id: proficiencyProgress
        anchors.fill: parent
        background-color: #2e8b57
        margin: 1 1 1 1
        percent: 0

    Panel
      id: bonusProgressBackground
      size: 532 240
      anchors.top: prev.bottom
      anchors.left: prev.left
      margin-top: 3
      background-color: alpha
      layout:
        type: grid
        cell-size: 76 240
        num-columns: 7

    UIWidget
      id: vocationWarning
      size: 532 16
      anchors.top: prev.top
      anchors.left: prev.left
      margin-top: 1
      margin-left: 1
      background-color: #ff9854
      text-align: center
      text: Perks are inactive because you don't meet the requirements to use this weapon.
      text-offset: 7 2
      visible: false

    Panel
      id: bonusDetailBackground
      size: 532 58
      anchors.top: bonusProgressBackground.bottom
      anchors.left: bonusProgressBackground.left
      margin-top: 3
      background-color: alpha
      layout:
        type: grid
        cell-size: 76 58
        num-columns: 7

  HorizontalSeparator
    id: bottomSep
    anchors.bottom: close.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 8
    margin-left: 4
    margin-right: 4

  Button
    id: close
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    !text: tr('Close')
    size: 55 20
    margin-bottom: 4
    margin-right: 4
    @onClick: modules.game_proficiency.WeaponProficiency:onCloseWindow()

  Button
    id: reset
    anchors.bottom: parent.bottom
    anchors.right: prev.left
    !text: tr('Reset')
    size: 55 20
    margin-bottom: 4
    margin-right: 5
    tooltip-delayed: true
    enabled: false
    @onClick: modules.game_proficiency.WeaponProficiency:onResetClick()

  Button
    id: apply
    anchors.bottom: parent.bottom
    anchors.right: prev.left
    !text: tr('Apply')
    size: 55 20
    margin-bottom: 4
    margin-right: 5
    tooltip-delayed: true
    enabled: false
    @onClick: modules.game_proficiency.WeaponProficiency:onApplyClick()

  Button
    id: ok
    anchors.bottom: parent.bottom
    anchors.right: prev.left
    !text: tr('Ok')
    size: 55 20
    margin-bottom: 4
    margin-right: 5
    tooltip-delayed: true
    enabled: false
    @onClick: modules.game_proficiency.WeaponProficiency:onOkClick()
